{
  "manifest_version": 3,
  "name": "CSST.at Stats PRO",
  "version": "16.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://steamcommunity.com/*",
    "https://api.allorigins.win/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/id/*", 
        "https://steamcommunity.com/profiles/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}